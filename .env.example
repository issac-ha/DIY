# LLM 配置（从学习项目复用 .env，或在此填写）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_api_key_here

# 数据库
DATABASE_URL=sqlite:///./diy_agent.db

# B站 Cookie（从浏览器 F12 复制，用于访问需要登录态的接口）
BILIBILI_COOKIE=your_cookie_here

# 视觉模型（火山方舟 Doubao-Seed-2.1-lite，支持文本+视觉+音频理解）
# Model ID 以控制台模型广场显示的为准（可能带日期后缀）
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-1-lite-260915
VISION_API_KEY=your_ark_api_key_here
